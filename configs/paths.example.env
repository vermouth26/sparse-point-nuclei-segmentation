# Copy this file to a location outside the package and replace every placeholder.
# This file contains filesystem locations only. Experiment parameters and seeds
# are configured in configs/ratio010_mainline.json.
export PYTHON=/path/to/python
export SAM2_PYTHON=/path/to/python-with-sam2
export PACKAGE_ROOT=/path/to/reproduction_ratio010
export DATA_ROOT=/path/to/data/raw
export PROCESSED_ROOT=/path/to/data/processed
export OUTPUT_ROOT=/path/to/new/output/directory
export SAM2_CHECKPOINT=/path/to/sam2.1_hiera_base_plus.pt
export SAM2_CONFIG=/path/to/sam2/configs/sam2.1/sam2.1_hiera_b+.yaml
export HOVERNET_PRETRAIN=/path/to/ImageNet-ResNet50-Preact_pytorch.tar
export HOVERNET_ROOT="$PACKAGE_ROOT/third_party/hover_net"
